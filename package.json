{
  "name": "portafolio-afmo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "docs:profiles": "python build/create_language_pdfs.py && python build/qa_language_pdfs.py",
    "docs:manuals": "python build/create_implementation_manuals.py",
    "verify": "pnpm run docs:profiles && pnpm run build",
    "test:unit": "node --test tests/portfolio-logic.unit.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:render",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .vercel"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
